# Hosted AI: set your key locally. Never put it in a VITE_ variable.
ROAM_AI_PROVIDER=openai
OPENAI_API_KEY=
ROAM_AI_MODEL=gpt-4.1-mini

# Alternatively, use an already installed local Ollama model:
# ROAM_AI_PROVIDER=ollama
# ROAM_AI_MODEL=qwen2.5:3b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# Demo data is opt-in. Live data failure otherwise gives an honest empty state.
ROAM_DEMO_DATA=false

# Production should set this to the deployed frontend origin.
ROAM_CORS_ORIGIN_REGEX=http://(localhost|127\.0\.0\.1):51\d{2}
